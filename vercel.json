{
  "redirects": [
    {
      "source": "/admin/:path+",
      "has": [{ "type": "host", "value": "withmeteoric.com" }],
      "destination": "https://admin.withmeteoric.com/admin/:path+",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "withmeteoric.com" }],
      "destination": "https://admin.withmeteoric.com/admin",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.withmeteoric.com" }],
      "destination": "/admin"
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "admin.withmeteoric.com" }],
      "destination": "/login"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.withmeteoric.com" }],
      "destination": "/admin/$1"
    }
  ]
}
